# =============================================================================
# MARSELLA - SISTEMA DE GESTIÓN ESCOLAR Y EVALUACIONES
# ARCHIVO DE PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env en esta misma carpeta:
#      copy .env.example .env (Windows)
#      cp .env.example .env (Linux/Mac)
# 2. Configura contraseñas seguras y secretos propios antes de desplegar a producción.
# 3. El archivo .env está excluido de git por seguridad (nunca lo compartas públicamente).
# =============================================================================

# --- ZONA HORARIA ---
TZ=America/Mexico_City

# --- BASE DE DATOS (POSTGRESQL) ---
POSTGRES_DB=examdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_EN_PRODUCCION
POSTGRES_PORT=5432

# --- CONEXIÓN SPRING BOOT (BACKEND) ---
# En Docker se usa el nombre del servicio 'postgres':
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/examdb
# Para ejecutar el backend localmente sin Docker descomenta:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/examdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_EN_PRODUCCION

# --- SEGURIDAD Y TOKENS JWT ---
# Clave Base64 segura de al menos 256 bits (32 bytes) para firmar tokens JWT.
# Puedes generar una en terminal con: openssl rand -base64 48
JWT_SECRET=c3VwZXItc2VjcmV0LWtleS1mb3ItZXhhbS1wbGF0Zm9ybS1tYXJzZWxsYS0yMDI2LXNwcmluZy1ib290LWF1dGg=
# Duración del token en milisegundos (604800000 ms = 7 días)
JWT_EXPIRATION_MS=604800000

# --- PUERTOS DE ACCESO EN EL HOST ---
BACKEND_PORT=8080
FRONTEND_PORT=80
FRONTEND_DEV_PORT=3000

# --- PROXY Y COMUNICACIÓN FRONTEND -> BACKEND ---
# En Docker (red interna del compose):
VITE_BACKEND_URL=http://backend:8080
# Para desarrollo frontend local en la máquina host (npm run dev):
# VITE_BACKEND_URL=http://localhost:8080

# --- MODO DE ENTORNO ---
# Valores: development | production
NODE_ENV=development

