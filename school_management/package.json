{
  "name": "school-management-root",
  "version": "1.0.0",
  "private": true,
  "description": "Marsella School Management & Exam Platform",
  "scripts": {
    "dev": "docker stop marsella_exam_frontend 2>nul & docker compose -f docker-compose.dev.yml up",
    "dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "prod": "docker compose up -d --build",
    "down": "docker compose down",
    "down:dev": "docker compose -f docker-compose.dev.yml down",
    "logs": "docker compose logs -f",
    "frontend:dev": "cd frontend && npm run dev"
  }
}
