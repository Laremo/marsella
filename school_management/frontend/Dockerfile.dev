# Development Dockerfile for React + Vite Frontend (Hot Module Replacement)
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source
COPY . .

EXPOSE 3000

# Run Vite in development mode (hot reloading on file save)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]

