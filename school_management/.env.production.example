# =============================================================================
# MARSELLA - SISTEMA ESCOLAR / EXÁMENES
# VARIABLES DE ENTORNO PARA PRODUCCIÓN (AWS / VPS)
# =============================================================================

TZ=America/Mexico_City

# --- BASE DE DATOS (POSTGRESQL) ---
POSTGRES_DB=examdb
POSTGRES_USER=marsella_admin
# Genera una contraseña segura alfanumérica
POSTGRES_PASSWORD=Definir_Password_Fuerte_Aqui_2026

# --- CONEXIÓN SPRING BOOT ---
# Si usas Postgres en el mismo Docker Compose:
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/examdb
SPRING_DATASOURCE_USERNAME=marsella_admin
SPRING_DATASOURCE_PASSWORD=Definir_Password_Fuerte_Aqui_2026

# Si usas AWS RDS Postgres, cambia la URL al endpoint de RDS:
# SPRING_DATASOURCE_URL=jdbc:postgresql://marsella-db.cxxxxxx.us-east-1.rds.amazonaws.com:5432/examdb

# --- SEGURIDAD JWT ---
# Genera una clave con: openssl rand -base64 48
JWT_SECRET=Cambiar_Por_Secret_Base64_Minimo_32_Bytes_2026_Key==
JWT_EXPIRATION_MS=604800000

# --- DATOS INICIALES ---
# En producción mantener false para no generar exámenes ni quizzes de demostración
SEED_DEMO=false
# Contraseñas iniciales para las cuentas por defecto (admin y directivo):
ADMIN_INITIAL_PASSWORD=Cambiar_Password_Admin_2026
DIRECTOR_INITIAL_PASSWORD=Cambiar_Password_Directivo_2026

# --- LÍMITES MEMORIA JAVA ---
# Optimizado para servidor de 2GB RAM (ej. AWS Lightsail $10 USD/mes)
JAVA_TOOL_OPTIONS=-Xms256m -Xmx896m
